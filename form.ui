         </property>
         <property name="toolTip">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;The lower, the faster the calculation. If too low, the result will be incorrect.&lt;/p&gt;&lt;p&gt;The optimal value depends on the laser pulse and the molecule in question.&lt;/p&gt;&lt;p&gt;Tip: for adiabatic alignment, Jmax can be really low.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Largest J quantum number |JKM&amp;gt;. Should be as low as possible.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
