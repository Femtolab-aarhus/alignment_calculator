            <item>
             <layout class="QHBoxLayout" name="horizontalLayout_17">
              <item>
               <widget class="QLabel" name="label_32">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Due to spin statistics and inversion/reflection symmetry, some rotational states either don't exists or are more abundant in nature than others.&lt;br/&gt;&lt;br/&gt;For example, the symmetric molecule CS2 can only occupy even J states, as &lt;span style=&quot; vertical-align:super;&quot;&gt;32&lt;/span&gt;S is a boson with spin 0 and the electronic ground state &lt;span style=&quot; vertical-align:super;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Σ&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;g&lt;/span&gt; is even. The total wavefunction should be even. It is electronic*rotational*nuclear. The nuclear and electronic parts are even, so the rotational wavefunction must also be even. O&lt;span style=&quot; vertical-align:sub;&quot;&gt;2&lt;/span&gt; can only exist in odd J states. Species with nonzero nuclear spin (e.g. H&lt;span style=&quot; vertical-align:sub;&quot;&gt;2&lt;/span&gt;) can have &amp;quot;strange&amp;quot; abundancies due to the difference between the number of odd and even nuclear states. Hydrogen for example is three times more likely to be in an odd J state than an even.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="frameShape">
                 <enum>QFrame::Shape::NoFrame</enum>
                </property>
                <property name="text">
                 <string>Even abundance</string>
                </property>
                <property name="alignment">
                 <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter</set>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QLineEdit" name="abundanceEven">
                <property name="layoutDirection">
                 <enum>Qt::LayoutDirection::LeftToRight</enum>
                </property>
                <property name="text">
                 <string/>
                </property>
                <property name="maxLength">
                 <number>8</number>
                </property>
                <property name="alignment">
                 <set>Qt::AlignmentFlag::AlignRight|Qt::AlignmentFlag::AlignTrailing|Qt::AlignmentFlag::AlignVCenter</set>
                </property>
                <property name="placeholderText">
                 <string>1</string>
                </property>
               </widget>
              </item>
             </layout>
            </item>
            <item>
             <layout class="QHBoxLayout" name="horizontalLayout_18">
              <item>
               <widget class="QLabel" name="label_33">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Due to spin statistics and inversion/reflection symmetry, some rotational states either don't exists or are more abundant in nature than others.&lt;br/&gt;&lt;br/&gt;For example, the symmetric molecule CS2 can only occupy even J states, as &lt;span style=&quot; vertical-align:super;&quot;&gt;32&lt;/span&gt;S is a boson with spin 0 and the electronic ground state &lt;span style=&quot; vertical-align:super;&quot;&gt;1&lt;/span&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Σ&lt;/span&gt;&lt;span style=&quot; font-weight:600; vertical-align:sub;&quot;&gt;g&lt;/span&gt; is even. The total wavefunction should be even. It is electronic*rotational*nuclear. The nuclear and electronic parts are even, so the rotational wavefunction must also be even. O&lt;span style=&quot; vertical-align:sub;&quot;&gt;2&lt;/span&gt; can only exist in odd J states. Species with nonzero nuclear spin (e.g. H&lt;span style=&quot; vertical-align:sub;&quot;&gt;2&lt;/span&gt;) can have &amp;quot;strange&amp;quot; abundancies due to the difference between the number of odd and even nuclear states. Hydrogen for example is three times more likely to be in an odd J state than an even.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="text">
                 <string>Odd abundance</string>
                </property>
                <property name="alignment">
                 <set>Qt::AlignmentFlag::AlignLeading|Qt::AlignmentFlag::AlignLeft|Qt::AlignmentFlag::AlignVCenter</set>
                </property>
               </widget>
              </item>
